datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PerfilUsuario {
  GERENTE
  VENDEDOR_COBRADOR
}

enum StatusParcela {
  PENDENTE
  PAGA
  ATRASADA
  PARCIAL
}

enum CategoriaProduto {
  MOVEIS
  VARIEDADES
}

enum TipoVenda {
  MOVEIS
  VARIEDADES
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String
  email     String        @unique
  senhaHash String
  perfil    PerfilUsuario
  ativo     Boolean       @default(true)
  criadoEm  DateTime      @default(now())

  vendas    Venda[]   @relation("VendedorVendas")
  cobrancas Parcela[] @relation("CobradorParcelas")
  pagamentosRecebidos Pagamento[] @relation("CobradorPagamentos")
}

model Cliente {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String
  endereco    String
  referencias String?
  criadoEm    DateTime @default(now())

  vendas      Venda[]
  pagamentos  Pagamento[]
}

model Produto {
  id        Int              @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Decimal          @db.Decimal(10, 2)
  categoria CategoriaProduto @default(MOVEIS)

  itensVenda ItemVenda[]
}

model Venda {
  id           Int       @id @default(autoincrement())
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  clienteId    Int
  vendedor     Usuario   @relation("VendedorVendas", fields: [vendedorId], references: [id])
  vendedorId   Int
  valorTotal   Decimal   @db.Decimal(10, 2)
  valorEntrada Decimal?  @db.Decimal(10, 2)
  numParcelas  Int
  dataVenda    DateTime  @default(now())
  tipoVenda    TipoVenda @default(MOVEIS)
  criadoEm    DateTime  @default(now())

  itens      ItemVenda[]
  parcelas   Parcela[]
  pagamentos Pagamento[]
}

model ItemVenda {
  id            Int     @id @default(autoincrement())
  venda         Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  vendaId       Int
  produto       Produto @relation(fields: [produtoId], references: [id])
  produtoId     Int
  quantidade    Int     @default(1)
  valorUnitario Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)
}

model Parcela {
  id             Int           @id @default(autoincrement())
  venda          Venda         @relation(fields: [vendaId], references: [id])
  vendaId        Int
  cobrador       Usuario       @relation("CobradorParcelas", fields: [cobradorId], references: [id])
  cobradorId     Int
  numero         Int
  valor          Decimal       @db.Decimal(10, 2)
  valorPago      Decimal?      @db.Decimal(10, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusParcela @default(PENDENTE)
  observacao     String?

  auditorias Auditoria[]
}

model Pagamento {
  id            Int      @id @default(autoincrement())
  venda         Venda    @relation(fields: [vendaId], references: [id])
  vendaId       Int
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  clienteId     Int
  cobrador      Usuario  @relation("CobradorPagamentos", fields: [cobradorId], references: [id])
  cobradorId    Int
  parcelaId     Int?
  valorPago     Decimal  @db.Decimal(10, 2)
  dataPagamento DateTime
  detalhes      String?
  criadoEm      DateTime @default(now())
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  parcela   Parcela? @relation(fields: [parcelaId], references: [id])
  parcelaId Int?
  usuarioId Int
  acao      String
  detalhes  String?
  criadoEm  DateTime @default(now())
}
