PORT=3300
# Supabase Transaction Pooler URL (porta 6543) - Recomendado para Vercel Serverless
DATABASE_URL="postgresql://postgres.[SEU_PROJETO_REF]:[SUA_SENHA]@aws-0-[SUA_REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (porta 5432) - Usado para migrações do Prisma
DIRECT_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO_REF].supabase.co:5432/postgres"

JWT_SECRET="sua_chave_secreta_jwt_aqui"

